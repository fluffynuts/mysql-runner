{
    "name": "mysql-runner",
    "version": "1.0.0",
    "description": "A brute-force mysql file runner, eg for (mostly) restoring wonky backups",
    "scripts": {
        "test": "zarro test-dotnet",
        "publish": "zarro dotnet-publish",
        "publish-local": "zarro publish-local",
        "zarro": "zarro",
        "build": "zarro @",
        "pack": "zarro @",
        "upgrade-packages": "run-s upgrade-pb upgrade-nexpect",
        "upgrade-pb": "cross-env UPGRADE_PACKAGES=/peanutbutter\\.*/ zarro upgrade-packages",
        "upgrade-nexpect": "cross-env UPGRADE_PACKAGES=nexpect,/nexpect\\.*/ zarro upgrade-packages"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/fluffynuts/mysql-runner.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/fluffynuts/mysql-runner/issues"
    },
    "homepage": "https://github.com/fluffynuts/mysql-runner#readme",
    "devDependencies": {
        "cross-env": "^7.0.2",
        "npm-run-all": "^4.1.5",
        "yafs": "^1.22.0",
        "zarro": "^1.197.0"
    }
}
